{
  "manifest_version": 3,
  "name": "Avis Downloads Bridge",
  "version": "1.0.0",
  "description": "Meldet deine Browser-Downloads an den Avis Launcher, damit sie dort im Downloads-Tab erscheinen.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "avis-downloads-bridge@avis-launcher.local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "Avis Downloads Bridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
