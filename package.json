{
  "name": "avis-launcher",
  "version": "0.1.0",
  "description": "Custom PC Game Launcher (Steam x PS5 UI) mit Cloud-Sync via rclone/S3/WebDAV",
  "main": "electron/main.js",
  "author": "You",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "release": "npm run build:renderer && electron-builder --publish always",
    "start": "cross-env NODE_ENV=production electron ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "archiver": "^7.0.1",
    "electron-updater": "^6.3.0",
    "extract-zip": "^2.0.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webdav": "^5.6.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.example.avislauncher",
    "productName": "Avis Launcher",
    "files": ["dist/**/*", "electron/**/*"],
    "publish": {
      "provider": "github",
      "owner": "jxnzs123",
      "repo": "avis-launcher"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
